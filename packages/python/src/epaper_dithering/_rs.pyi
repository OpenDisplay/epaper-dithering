from typing import final

_Entry = tuple[tuple[float, float, float], str | None, tuple[int, int, int] | None]

class PaletteError(ValueError): ...

@final
class Palette:
    def __new__(cls, entries: list[_Entry], measured: bool = ...) -> Palette: ...
    @staticmethod
    def from_json(s: str) -> Palette: ...
    @staticmethod
    def from_absolute_lab(entries: list[_Entry], white_index: int, measured: bool = ...) -> Palette: ...
    @staticmethod
    def from_srgb(
        colors: list[tuple[tuple[int, int, int], str | None, tuple[int, int, int] | None]], measured: bool = ...
    ) -> Palette: ...
    def with_source(self, source: str) -> Palette: ...
    def to_json(self) -> str: ...
    def entries(self) -> list[_Entry]: ...
    @property
    def measured(self) -> bool: ...
    @property
    def source(self) -> str | None: ...
    def index_of(self, name: str) -> int | None: ...
    def preview_rgb(self) -> list[tuple[int, int, int]]: ...
    def __len__(self) -> int: ...

def dither_image(
    pixels: bytes,
    width: int,
    height: int,
    palette: Palette,
    *,
    mode: str = ...,
    serpentine: bool = ...,
    exposure: float = ...,
    saturation: float = ...,
    shadows: float = ...,
    highlights: float = ...,
    tone: float = ...,
    gamut: float = ...,
    dbs_passes: int | None = ...,
    dbs_viewing_distance_cm: float = ...,
    dbs_ppi: float = ...,
    anchor: bool = ...,
    snap: bool = ...,
) -> bytes: ...
def composite_rgba(rgba: bytes) -> bytes: ...
